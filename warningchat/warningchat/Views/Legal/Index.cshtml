
@using WarningSystems.Core.Services
@using WarningSystems.Core.ViewModels

@model WarningSystems.Core.ViewModels.LegalWizardVm

@{
    ViewData["Title"] = "Legal";

    string ValOrDash(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "—" : value.Trim();
    }
    string StripHtml(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "—";

        var text = System.Text.RegularExpressions.Regex.Replace(value, "<.*?>", " ");

        text = System.Net.WebUtility.HtmlDecode(text);

        text = System.Text.RegularExpressions.Regex.Replace(text, @"\s+", " ");

        return string.IsNullOrWhiteSpace(text) ? "—" : text.Trim();
    }
    var issueEmployee = ValOrDash(Model.EmployeeIdDesplayName);
    var issueCreatedBy = ValOrDash(Model.CreatedByDesplayName);
    var issueCategory = ValOrDash(Model.CategoryName);
    var issueStatus = ValOrDash(Model.Status);
    var issueType = ValOrDash(Model.Type);
    var warningCategory = ValOrDash(Model.WarningSubtype);
    var canValidate = string.Equals(Model.Status, "Completed", StringComparison.OrdinalIgnoreCase);
    var canRecordDecision = string.Equals(Model.Status, "In Progress", StringComparison.OrdinalIgnoreCase);

    var issueCreatedOn = Model.CreatedOn == default
        ? "—"
        : Model.CreatedOn.ToString("yyyy/MM/dd HH:mm");

    var issueSubmittedOn = Model.SubmittedOn.HasValue
        ? Model.SubmittedOn.Value.ToString("yyyy/MM/dd HH:mm")
        : "—";

    var issueDueDate = Model.LegalExpiryDate.HasValue
        ? Model.LegalExpiryDate.Value.ToString("yyyy/MM/dd")
        : "—";

    var descriptionQuestion = Model.Questions?
        .FirstOrDefault(q => q.QuestionId == 2);

    var issueDescriptionRaw = !string.IsNullOrWhiteSpace(descriptionQuestion?.AnswerText)
        ? descriptionQuestion.AnswerText
        : !string.IsNullOrWhiteSpace(descriptionQuestion?.AnswerJson)
            ? descriptionQuestion.AnswerJson
            : "—";

    var issueDescription = StripHtml(issueDescriptionRaw);

    var docsCount = Model.Evidence?
        .Count(x => !string.IsNullOrWhiteSpace(x.FileName)) ?? 0;

    var generalNotesCount = Model.Notes?.Count ?? 0;

    var documentNotesCount = (Model.Evidence ?? new List<LegalEvidenceVm>())
        .Where(e => e.Notes != null && e.Notes.Any())
        .SelectMany(e => e.Notes)
        .Count();
}

<div class="ws-page">
    <div class="ws-page-inner">



        <div class="page-actions d-flex gap-2">
            @if (canRecordDecision)
            {
                <button type="button"
                        class="ws-btn-primary-pill"
                        data-bs-toggle="modal"
                        data-bs-target="#completeModal">
                    Record Decision
                </button>
            }

            @if (canValidate)
            {
                <button type="button"
                        class="btn btn-success"
                        style="border-radius:999px;"
                        id="btnValidateIssue"
                        onclick="validateIssue(this)">
                    Validate
                </button>
            }

            <button type="button"
                    class="ws-btn-primary-pill"
                    style="border-radius:999px;"
                    data-bs-toggle="modal"
                    data-bs-target="#dueDateModal">
                Change Due Date
            </button>

        </div>
        <div class="mb-4">
            <h5 class="mb-2">Issue Recap</h5>

            <div class="row g-3">

                <div class="col-12 col-md-6 col-xl-3">
                    <div class="ws-ov-card ws-ov-trans h-100">
                        <div class="ws-ov-card-head">1. Issue</div>
                        <div class="ws-ov-card-body">
                            <div class="ws-ov-row">
                                <div class="ws-ov-label">Warning ID:</div>
                                <div class="ws-ov-value">#@Model.WarningId</div>
                            </div>

                            <div class="ws-ov-row">
                                <div class="ws-ov-label">Employee:</div>
                                <div class="ws-ov-value text-truncate" title="@issueEmployee">
                                    @issueEmployee
                                </div>
                            </div>

                            <div class="ws-ov-row">
                                <div class="ws-ov-label">Category:</div>
                                <div class="ws-ov-value text-truncate" title="@issueCategory">
                                    @issueCategory
                                </div>
                            </div>

                            <div class="ws-ov-row">
                                <div class="ws-ov-label">Status:</div>
                                <div class="ws-ov-value">@issueStatus</div>
                            </div>
                            <div class="ws-ov-row">
                                <div class="ws-ov-label">Type:</div>
                                <div class="ws-ov-value">@issueType</div>
                            </div>
                            @if (string.Equals(Model.Type, "Warning", StringComparison.OrdinalIgnoreCase))
                            {
                                <div class="ws-ov-row">
                                    <div class="ws-ov-label">Warning category:</div>
                                    <div class="ws-ov-value">@warningCategory</div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="col-12 col-md-6 col-xl-3">
                    <div class="ws-ov-card ws-ov-dates h-100">
                        <div class="ws-ov-card-head">2. Dates</div>
                        <div class="ws-ov-card-body">
                            <div class="ws-ov-row">
                                <div class="ws-ov-label">Created:</div>
                                <div class="ws-ov-value">@issueCreatedOn</div>
                            </div>

                            <div class="ws-ov-row">
                                <div class="ws-ov-label">Submitted:</div>
                                <div class="ws-ov-value">@issueSubmittedOn</div>
                            </div>

                            <div class="ws-ov-row">
                                <div class="ws-ov-label">Due Date:</div>
                                <div class="ws-ov-value">@issueDueDate</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-md-6 col-xl-3">
                    <div class="ws-ov-card ws-ov-desc h-100">
                        <div class="ws-ov-card-head">3. Description</div>

                        <div class="ws-ov-card-body">
                            <div class="ws-ov-row">
                                <div class="ws-ov-label">Description:</div>

                                <div class="ws-ov-value description-text">
                                    @issueDescription
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-md-6 col-xl-3">
                    <div class="ws-ov-card ws-ov-att h-100">
                        <div class="ws-ov-card-head">4. Evidence / Interactions</div>
                        <div class="ws-ov-card-body">
                            <div class="ws-ov-row">
                                <div class="ws-ov-label">Documents:</div>
                                <div class="ws-ov-value">@docsCount</div>
                            </div>

                            <div class="ws-ov-row">
                                <div class="ws-ov-label">General:</div>
                                <div class="ws-ov-value">@generalNotesCount</div>
                            </div>

                            <div class="ws-ov-row">
                                <div class="ws-ov-label">Document:</div>
                                <div class="ws-ov-value">@documentNotesCount</div>
                            </div>

                            <div class="ws-ov-row">
                                <div class="ws-ov-label">Created By:</div>
                                <div class="ws-ov-value text-truncate" title="@issueCreatedBy">
                                    @issueCreatedBy
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
        <div class="main-panel">

            <ul class="nav nav-tabs hw-tabs" id="legalTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active"
                            id="notes-tab"
                            data-bs-toggle="tab"
                            data-bs-target="#notes"
                            type="button"
                            role="tab"
                            aria-controls="notes"
                            aria-selected="true">
                        Interactions
                    </button>
                </li>

                <li class="nav-item" role="presentation">
                    <button class="nav-link"
                            id="history-tab"
                            data-bs-toggle="tab"
                            data-bs-target="#history"
                            type="button"
                            role="tab"
                            aria-controls="history"
                            aria-selected="false">
                        Issue History
                    </button>
                </li>

                <li class="nav-item" role="presentation">
                    <button class="nav-link"
                            id="docs-tab"
                            data-bs-toggle="tab"
                            data-bs-target="#docs"
                            type="button"
                            role="tab"
                            aria-controls="docs"
                            aria-selected="false">
                        Documents
                    </button>
                </li>
            </ul>
           
            <div class="tab-content">

                <!-- NOTES TAB -->
                <div class="tab-pane fade"
                     id="notes"
                     role="tabpanel"
                     aria-labelledby="notes-tab">

                    <div class="panel-body">

                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div>
                                <h5 class="mb-1">Interactions</h5>
                                <div class="text-muted">
                                    General interactions and interactions linked to uploaded evidence.
                                </div>
                            </div>

                            <button type="button"
                                    class="ws-btn-primary-pill"
                                    style="border-radius:999px;"
                                    data-bs-toggle="modal"
                                    data-bs-target="#uploadDocsModal">
                                Add Evidence
                            </button>
                        </div>

                        @{
                            var allInteractions = new List<dynamic>();

                            if (Model.Notes != null && Model.Notes.Any())
                            {
                                allInteractions.AddRange(Model.Notes.Select(n => new
                                {
                                    NoteText = n.NoteText,
                                    CreatedOnUtc = n.CreatedOnUtc,
                                    CreatedBy = string.IsNullOrWhiteSpace(n.CreatedByDisplayName)
                                ? n.CreatedBy
                                : n.CreatedByDisplayName,
                                    DocumentName = "",
                                    DocumentType = "",
                                    DocumentSize = ""
                                }));
                            }

                            var evidenceWithNotes = (Model.Evidence ?? new List<LegalEvidenceVm>())
                            .Where(e => e.Notes != null && e.Notes.Any())
                            .ToList();

                            foreach (var evidence in evidenceWithNotes)
                            {
                                foreach (var note in evidence.Notes)
                                {
                                    allInteractions.Add(new
                                    {
                                        NoteText = note.NoteText,
                                        CreatedOnUtc = note.CreatedOnUtc,
                                        CreatedBy = string.IsNullOrWhiteSpace(note.CreatedByDisplayName)
                                    ? note.CreatedBy
                                    : note.CreatedByDisplayName,
                                        DocumentName = FileNameHelper.GetDisplayFileName(evidence.FileName),
                                        DocumentType = evidence.FileType ?? "",
                                        DocumentSize = $"{evidence.FileSizeBytes:N0} bytes"
                                    });
                                }
                            }

                            var orderedInteractions = allInteractions
                            .OrderByDescending(x => x.CreatedOnUtc)
                            .ToList();
                        }

                        <div>
                            <h5 class="mb-2">All Interactions</h5>

                            <div class="table-responsive">
                                <table class="table table-hover align-middle" id="interactionsTable">
                                    <thead>
                                        <tr>
                                            <th style="width:45%;">Interaction</th>
                                            <th style="width:18%;">Added On</th>
                                            <th style="width:18%;">Added By</th>
                                            <th style="width:19%;">Document</th>
                                        </tr>
                                    </thead>

                                    <tbody>
                                        @if (!orderedInteractions.Any())
                                        {
                                            <tr>
                                                <td colspan="4" class="text-center text-muted py-4">
                                                    No interactions yet.
                                                </td>
                                            </tr>
                                        }
                                        else
                                        {
                                            foreach (var interaction in orderedInteractions)
                                            {
                                                <tr>
                                                    <td >
                                                        @interaction.NoteText
                                                    </td>

                                                    <td>
                                                        @interaction.CreatedOnUtc.ToString("yyyy/MM/dd HH:mm")
                                                    </td>

                                                    <td>
                                                        @interaction.CreatedBy
                                                    </td>

                                                    <td>
                                                        @if (string.IsNullOrWhiteSpace(interaction.DocumentName))
                                                        {
                                                            <span class="text-muted">General</span>
                                                        }
                                                        else
                                                        {
                                                            <div class="fw-semibold">
                                                                @interaction.DocumentName
                                                            </div>

                                                            <div class="text-muted small">
                                                                @interaction.DocumentType • @interaction.DocumentSize
                                                            </div>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <div class="table-footer mt-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <div class="text-muted small" id="interactionsPageInfo"></div>

                                <div class="pager-buttons btn-group" role="group" aria-label="Interactions pagination">
                                    <button type="button"
                                            class="btn btn-outline-secondary btn-sm"
                                            id="interactionsPrevBtn">
                                        Previous
                                    </button>

                                    <button type="button"
                                            class="btn btn-outline-secondary btn-sm"
                                            id="interactionsNextBtn">
                                        Next
                                    </button>
                                </div>
                            </div>


                        </div>

                    </div>
                </div>












                <!-- HISTORY TAB -->
                <div class="tab-pane fade" id="history" role="tabpanel" aria-labelledby="history-tab">
                    <div class="panel-body">
                        <h5 class="mb-2">Issue History</h5>
                        <div class="text-muted mb-3">
                            All warnings for this employee, most recent first.
                        </div>

                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead>
                                    <tr>
                                        <th>Created On</th>
                                        <th>Status</th>
                                        <th>Last Changed By</th>
                                        <th>Category</th>
                                        <th class="text-end">Issue</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @if (Model.TransgretionHistory == null || !Model.TransgretionHistory.Any())
                                    {
                                        <tr>
                                            <td colspan="5" class="text-center text-muted py-4">
                                                No history data available.
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        foreach (var h in Model.TransgretionHistory)
                                        {
                                            <tr>
                                                <td>@h.CreatedOn.ToString("yyyy/MM/dd")</td>
                                                <td>@h.Status</td>
                                                <td>
                                                    @(string.IsNullOrWhiteSpace(h.LastStatusChangedByDisplayName)
                                                                                                ? "-"
                                                                                                : h.LastStatusChangedByDisplayName)
                                                </td>
                                                <td>@h.CategoryName</td>
                                                <td class="text-end">
                                                    <a class="btn btn-outline-secondary btn-sm"
                                                       style="border-radius:999px;"
                                                       href="@Url.Action("Index", "Legal", new { id = h.WarningId })">
                                                        View
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>

                    </div>
                </div>

                <!-- DOCUMENTS TAB -->
                <div class="tab-pane fade" id="docs" role="tabpanel" aria-labelledby="docs-tab">
                    <div class="panel-body">

                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div>
                                <h5 class="mb-1">Documents</h5>
                                <div class="text-muted">
                                    Showing uploaded evidence documents.
                                </div>
                            </div>

                            <button type="button"
                                    class="ws-btn-primary-pill"
                                    style="border-radius:999px;"
                                    data-bs-toggle="modal"
                                    data-bs-target="#uploadDocsModal">
                                Upload Document
                            </button>
                        </div>

                        @{
                            var docs = (Model.Evidence ?? new List<LegalEvidenceVm>())
                            .Where(x => !string.IsNullOrWhiteSpace(x.FileName))
                            .GroupBy(x => x.FileName)
                            .Select(g => g.OrderByDescending(x => x.UploadedOn).First())
                            .OrderByDescending(x => x.UploadedOn)
                            .ToList();
                        }

                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead>
                                    <tr>
                                        <th>File</th>
                                        <th>Type</th>
                                        <th>Size</th>
                                        <th>Uploaded By</th>
                                        <th>Uploaded On</th>
                                        <th></th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @if (!docs.Any())
                                    {
                                        <tr>
                                            <td colspan="6" class="text-center text-muted py-4">
                                                No documents found.
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        foreach (var d in docs)
                                        {
                                            <tr>
                                                <td class="fw-semibold">
                                                    @FileNameHelper.GetDisplayFileName(d.FileName)
                                                </td>
                                                <td>@d.FileType</td>
                                                <td>@d.FileSizeBytes.ToString("N0")</td>
                                                <td>
                                                    @(string.IsNullOrWhiteSpace(d.UploadedByDisplayName)
                                                                                                ? d.UploadedBy
                                                                                                : d.UploadedByDisplayName)
                                                </td>
                                                <td>@d.UploadedOn.ToString("yyyy/MM/dd HH:mm")</td>
                                                <td class="text-end">
                                                    <a class="btn btn-outline-secondary"
                                                       style="border-radius:999px;"
                                                       href="@Url.Action("Download", "Legal", new { warningId = Model.WarningId, fileName = d.FileName })">
                                                        Download
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>

                    </div>
                </div>

            </div>
        </div>

    </div>
</div>

<!-- ADD NOTE MODAL -->
<div class="modal fade" id="addNoteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Add New Note</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">

                <input type="hidden" id="addNoteWarningId" value="@Model.WarningId" />

                <div class="mb-3">
                    <label class="form-label">Note Type</label>

                    <select class="form-select" id="addNoteTypeId">
                        <option value="">Select Interactions type</option>

                        @foreach (var type in Model.NoteTypes)
                        {
                            <option value="@type.NoteTypeId">@type.Name</option>
                        }
                    </select>

                    <div class="form-text text-muted">
                        Choose what type of Interactions this is.
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Link to Document</label>

                    <select class="form-select" id="addNoteEvidenceId">
                        <option value="">General Interactions - not linked to a document</option>

                        @foreach (var e in (Model.Evidence ?? new List<LegalEvidenceVm>())
                                                .Where(x => !string.IsNullOrWhiteSpace(x.FileName))
                                                .OrderByDescending(x => x.UploadedOn))
                        {
                            <option value="@e.EvidenceId">
                                @FileNameHelper.GetDisplayFileName(e.FileName)
                            </option>
                        }
                    </select>

                    <div class="form-text text-muted">
                        Leave this as general Interactions if the Interactions is not about a specific document.
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Note</label>
                    <textarea class="form-control"
                              id="addNoteText"
                              rows="4"
                              placeholder="Type your Interactions..."></textarea>
                    <div class="form-text text-muted">
                        This will be appended and saved as a new Interactions.
                    </div>
                </div>

            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <button type="button"
                        class="btn btn-primary"
                        id="btnAddNote"
                        onclick="addEvidenceNote(this)">
                    Add Interactions
                </button>
            </div>

        </div>
    </div>
</div>

<!-- UPLOAD DOCS MODAL -->
<div class="modal fade" id="uploadDocsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Upload Documents</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <input type="hidden" id="uploadWarningId" value="@Model.WarningId" />

                <div class="mb-3">
                    <label class="form-label">Files</label>
                    <input class="form-control" type="file" id="uploadFiles" multiple />
                    <div class="form-text text-muted">Select one or more files.</div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Notes (optional)</label>
                    <textarea class="form-control"
                              id="uploadNotes"
                              rows="3"
                              placeholder="Optional Interactions..."></textarea>
                    <div class="form-text text-muted">
                        Interactions added with documents will be saved as Investigation Interactions.
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <button type="button"
                        class="btn btn-primary"
                        id="btnUploadDocs"
                        onclick="uploadDocuments(this)">
                    Upload
                </button>
            </div>

        </div>
    </div>
</div>

<!-- COMPLETE MODAL -->
<div class="modal fade" id="completeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Record Legal Decision</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">

                <input type="hidden" id="completeWarningId" value="@Model.WarningId" />

                <div class="d-flex justify-content-between mb-3">
                    <div><strong>Employee Name:</strong> @Model.EmployeeIdDesplayName</div>
                    <div><strong>Submitter Name:</strong> @Model.CreatedByDesplayName</div>
                </div>

                <div class="border rounded p-3">

                    <div class="fw-semibold mb-2">Select legal decision</div>

                    <div class="form-check">
                        <input class="form-check-input"
                               type="radio"
                               name="completeStatus"
                               id="stInvalid"
                               value="Invalid"
                               checked>
                        <label class="form-check-label" for="stInvalid">Invalid</label>
                    </div>

                    <div class="form-check">
                        <input class="form-check-input"
                               type="radio"
                               name="completeStatus"
                               id="stDiscussion"
                               value="Discussion">
                        <label class="form-check-label" for="stDiscussion">Discussion</label>
                    </div>

                    <div class="form-check">
                        <input class="form-check-input"
                               type="radio"
                               name="completeStatus"
                               id="stWarning"
                               value="Warning">
                        <label class="form-check-label" for="stWarning">Warning</label>
                    </div>

                    <div class="form-check mb-3">
                        <input class="form-check-input"
                               type="radio"
                               name="completeStatus"
                               id="stHearing"
                               value="Hearing">
                        <label class="form-check-label" for="stHearing">Hearing</label>
                    </div>

                    <div class="mb-3 d-none" id="warningSubtypeGroup">
                        <label class="form-label" for="warningSubtype">Warning category</label>
                        <select class="form-select" id="warningSubtype">
                            <option value="">Select warning category</option>
                            <option value="Verbal warning">Verbal warning</option>
                            <option value="1st written warning">1st written warning</option>
                            <option value="2nd written warning">2nd written warning</option>
                            <option value="Final warning">Final warning</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Upload supporting document (optional)</label>
                        <input class="form-control" type="file" id="completeFile" />
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <button type="button"
                        class="btn btn-primary"
                        id="btnComplete"
                        onclick="completeTransgression(this)">
                    Submit
                </button>
            </div>

        </div>
    </div>
</div>

<!-- DUE DATE MODAL -->
<div class="modal fade" id="dueDateModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Change Due Date</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <input type="hidden" id="dueDateWarningId" value="@Model.WarningId" />

                <div class="mb-3">
                    <label class="form-label">New due date</label>
                    <input type="date" class="form-control" id="dueDateValue" />
                    <div class="form-text text-muted">
                        Must be in the future and not on a weekend.
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Reason</label>
                    <textarea class="form-control"
                              id="dueDateReason"
                              rows="3"
                              placeholder="Why are you changing the due date?"></textarea>
                    <div class="form-text text-muted">
                        This will be saved into the audit log.
                    </div>
                </div>

                <div class="text-muted mt-2" id="dueDateSaveMsg" style="display:none;"></div>
            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <button type="button"
                        class="btn btn-primary"
                        id="btnSaveDueDate"
                        onclick="updateDueDate(this)">
                    Save Due Date
                </button>
            </div>

        </div>
    </div>
</div>

<script>
    async function addEvidenceNote(btn) {
        debugger;
        const warningEl = document.getElementById("addNoteWarningId");
        const typeEl = document.getElementById("addNoteTypeId");
        const evidenceEl = document.getElementById("addNoteEvidenceId");
        const textEl = document.getElementById("addNoteText");

        if (!warningEl || !typeEl || !evidenceEl || !textEl) {
            console.warn("Missing modal elements:", { warningEl, typeEl, evidenceEl, textEl });
            alert("Modal inputs not found. Check element IDs.");
            return;
        }

        const warningId = parseInt(warningEl.value || "0", 10);
        const noteTypeId = parseInt(typeEl.value || "0", 10);

        const evidenceValue = (evidenceEl.value || "").trim();
        const evidenceId = evidenceValue ? parseInt(evidenceValue, 10) : null;

        const noteText = (textEl.value || "").trim();

        if (!warningId) {
            alert("Missing WarningId.");
            return;
        }

        if (!noteTypeId) {
            alert("Please select a note type.");
            return;
        }

        if (!noteText) {
            alert("Please type a note.");
            return;
        }

        btn.disabled = true;

        try {
            const res = await fetch("/Legal/AddEvidenceNote", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                    warningId: warningId,
                    evidenceId: evidenceId,
                    noteTypeId: noteTypeId,
                    noteText: noteText
                })
            });

            if (!res.ok) {
                const txt = await res.text();
                throw new Error(txt || `HTTP ${res.status}`);
            }

            const modalEl = document.getElementById("addNoteModal");
            let modal = bootstrap.Modal.getInstance(modalEl);
            if (!modal) modal = new bootstrap.Modal(modalEl);
            modal.hide();

            typeEl.value = "";
            evidenceEl.value = "";
            textEl.value = "";

            location.reload();

        } catch (err) {
            alert("Failed to add note: " + (err?.message || err));
        } finally {
            btn.disabled = false;
        }
    }

    async function uploadDocuments(btn) {

        const warningId = parseInt(document.getElementById("uploadWarningId")?.value || "0", 10);
        const filesInput = document.getElementById("uploadFiles");
        const notes = (document.getElementById("uploadNotes")?.value || "").trim();

        if (!warningId) {
            alert("Missing WarningId.");
            return;
        }

        if (!filesInput || !filesInput.files || filesInput.files.length === 0) {
            alert("Please select at least one file.");
            return;
        }

        btn.disabled = true;

        try {
            const fd = new FormData();

            fd.append("WarningId", warningId.toString());
            fd.append("AttachmentType", "LegalEvidence");
            fd.append("Notes", notes);

            for (const file of filesInput.files) {
                fd.append("Files", file, file.name);
                fd.append("AttachmentNames", file.name);
            }

            const res = await fetch("/Legal/SaveEvidenceAttachment", {
                method: "POST",
                body: fd
            });

            if (!res.ok) {
                const txt = await res.text();
                throw new Error(txt || `HTTP ${res.status}`);
            }

            const modalEl = document.getElementById("uploadDocsModal");
            let modal = bootstrap.Modal.getInstance(modalEl);
            if (!modal) modal = new bootstrap.Modal(modalEl);
            modal.hide();

            filesInput.value = "";

            const uploadNotesEl = document.getElementById("uploadNotes");
            if (uploadNotesEl) {
                uploadNotesEl.value = "";
            }

            location.reload();

        } catch (err) {
            alert("Upload failed: " + (err?.message || err));
        } finally {
            btn.disabled = false;
        }
    }

    async function completeTransgression(btn) {

        const warningId = parseInt(document.getElementById("completeWarningId")?.value || "0", 10);

        if (!warningId) {
            alert("Missing WarningId.");
            return;
        }

        const statusEl = document.querySelector('input[name="completeStatus"]:checked');
        const status = statusEl ? statusEl.value : "";

        if (!status) {
            alert("Please select a status.");
            return;
        }

        const type = status;
        const warningSubtype = document.getElementById("warningSubtype")?.value || "";

        if (type === "Warning" && !warningSubtype) {
            alert("Please select a warning category.");
            return;
        }

        const fileInput = document.getElementById("completeFile");
        const file = (fileInput && fileInput.files && fileInput.files.length > 0)
            ? fileInput.files[0]
            : null;

        btn.disabled = true;

        try {
            const fd = new FormData();
            fd.append("WarningId", warningId.toString());
            fd.append("Status", status);
            fd.append("Type", type);
            fd.append("WarningSubtype", warningSubtype);

            if (file) {
                fd.append("File", file, file.name);
            }

            const res = await fetch("/Legal/CompleteTransgression", {
                method: "POST",
                body: fd
            });

            if (!res.ok) {
                const txt = await res.text();
                throw new Error(txt || `HTTP ${res.status}`);
            }

            const modalEl = document.getElementById("completeModal");
            let modal = bootstrap.Modal.getInstance(modalEl);
            if (!modal) modal = new bootstrap.Modal(modalEl);
            modal.hide();

            if (fileInput) {
                fileInput.value = "";
            }

            location.reload();

        } catch (err) {
            alert("Failed to complete: " + (err?.message || err));
        } finally {
            btn.disabled = false;
        }
    }

    async function validateIssue(btn) {
        const warningId = @Model.WarningId;
        const confirmed = confirm(
            "Confirm that all required steps are complete and the Team Leader or Line Manager added the information to PaySpace."
        );

        if (!confirmed) return;

        btn.disabled = true;
        const originalText = btn.textContent;
        btn.textContent = "Validating...";

        try {
            const res = await fetch("/Legal/ValidateTransgression", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ warningId: warningId })
            });
            const data = await res.json().catch(() => ({}));

            if (!res.ok || data.success === false) {
                throw new Error(data.message || "Failed to validate the issue.");
            }

            location.reload();
        } catch (err) {
            alert("Failed to validate: " + (err?.message || err));
            btn.disabled = false;
            btn.textContent = originalText;
        }
    }

    document.querySelectorAll('input[name="completeStatus"][type="radio"]').forEach(input => {
        input.addEventListener("change", function () {
            const group = document.getElementById("warningSubtypeGroup");
            const select = document.getElementById("warningSubtype");
            const isWarning = this.value === "Warning";
            group?.classList.toggle("d-none", !isWarning);
            if (select) {
                select.required = isWarning;
                if (!isWarning) select.value = "";
            }
        });
    });

    function showDueDateMsg(text, isError) {
        const el = document.getElementById("dueDateSaveMsg");
        if (!el) return;

        el.style.display = "block";
        el.className = isError ? "text-danger mt-2" : "text-success mt-2";
        el.textContent = text;

        setTimeout(() => {
            el.style.display = "none";
        }, 3500);
    }

    function isWeekend(dateStr) {
        const d = new Date(dateStr + "T00:00:00");
        const day = d.getDay();
        return day === 0 || day === 6;
    }

    async function updateDueDate(btn) {
        const warningId = parseInt(document.getElementById("dueDateWarningId")?.value || "0", 10);
        const dueDate = (document.getElementById("dueDateValue")?.value || "").trim();
        const reason = (document.getElementById("dueDateReason")?.value || "").trim();

        if (!warningId) {
            showDueDateMsg("Missing WarningId.", true);
            return;
        }

        if (!dueDate) {
            showDueDateMsg("Please select a due date.", true);
            return;
        }

        if (isWeekend(dueDate)) {
            showDueDateMsg("Due date cannot be on a weekend.", true);
            return;
        }

        if (!reason) {
            showDueDateMsg("Reason is required.", true);
            return;
        }

        btn.disabled = true;
        showDueDateMsg("Saving...", false);

        try {
            const res = await fetch("/Legal/UpdateDueDate", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                    warningId: warningId,
                    dueDate: dueDate,
                    reason: reason
                })
            });

            const data = await res.json().catch(() => ({}));

            if (!res.ok || data.success === false) {
                showDueDateMsg(data.message || "Save failed.", true);
                return;
            }

            showDueDateMsg("Saved ✅", false);

            setTimeout(() => {
                const modalEl = document.getElementById("dueDateModal");
                let modal = bootstrap.Modal.getInstance(modalEl);
                if (!modal) modal = new bootstrap.Modal(modalEl);
                modal.hide();

                location.reload();
            }, 600);

        } catch (err) {
            showDueDateMsg("Network error: " + (err?.message || err), true);
        } finally {
            btn.disabled = false;
        }
    }
</script>
