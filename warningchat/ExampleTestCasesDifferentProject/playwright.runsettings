<?xml version="1.0" encoding="utf-8"?>
<RunSettings>

	<RunConfiguration>
		<EnvironmentVariables>
			<HEADED>1</HEADED>
			<DEBUG>pw:api</DEBUG>
		</EnvironmentVariables>
	</RunConfiguration>

	<Playwright>
		<BrowserName>chromium</BrowserName>

		<LaunchOptions>
			<Headless>false</Headless>
			<SlowMo>500</SlowMo>
		</LaunchOptions>
	</Playwright>

</RunSettings>