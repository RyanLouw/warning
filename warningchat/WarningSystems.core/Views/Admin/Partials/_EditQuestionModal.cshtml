<div class="modal fade" id="modalEditQuestion" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">

            <form method="post" action="@Url.Action("EditQuestion", "Admin")">
                @Html.AntiForgeryToken()

                <div class="modal-header">
                    <h5 class="modal-title">Edit Question</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">

                    <input type="hidden" name="QuestionId" id="editQuestionId" />

                    <div class="mb-3">
                        <label class="form-label">Question Text</label>
                        <input name="QuestionText"
                               id="editQuestionText"
                               class="form-control"
                               required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Control Type</label>
                        <select name="ControlType"
                                id="editQuestionControl"
                                class="form-select"
                                required>
                            <option value="">-- Select --</option>
                            <option value="Text">Text</option>
                            <option value="Dropdown">Dropdown</option>
                            <option value="Radio">Radio</option>
                            <option value="Checkbox">Checkbox</option>
                            <option value="TrueFalse">True / False</option>
                            <option value="Number">Number</option>
                            <option value="Date">Date</option>
                        </select>
                    </div>

                    <div class="mb-3" id="editConfigBuilder" style="display:none;">

                        <label class="form-label">Options / Settings</label>

                        <div id="editOptionsBuilder" style="display:none;">
                            <div class="d-flex gap-2 mb-2">
                                <input id="editOptionInput"
                                       type="text"
                                       class="form-control"
                                       placeholder="Type an option">
                                <button type="button"
                                        class="btn btn-outline-primary"
                                        id="editBtnAddOption">
                                    Add
                                </button>
                            </div>

                            <div class="form-text mb-2">
                                Add the options users will pick from.
                            </div>

                            <ul class="list-group" id="editOptionsList"></ul>

                            <div class="mt-3">
                                <label class="form-label mb-1">Default selected (optional)</label>
                                <select class="form-select" id="editDefaultOptionSelect">
                                    <option value="">-- None --</option>
                                </select>
                            </div>
                        </div>

                        <div id="editBooleanPreset" style="display:none;">
                            <div class="form-text mb-2">
                                This will automatically create the Yes/No or True/False options.
                            </div>

                            <label class="form-label mb-1">Default selected (optional)</label>
                            <select class="form-select" id="editDefaultBooleanSelect">
                                <option value="">-- None --</option>
                                <option value="true">True / Yes</option>
                                <option value="false">False / No</option>
                            </select>
                        </div>

                        <div id="editNumberConfig" style="display:none;">
                            <div class="row g-2">
                                <div class="col-md-4">
                                    <label class="form-label mb-1">Min</label>
                                    <input type="number" class="form-control" id="editNumMin">
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label mb-1">Max</label>
                                    <input type="number" class="form-control" id="editNumMax">
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label mb-1">Step</label>
                                    <input type="number" class="form-control" id="editNumStep" value="1">
                                </div>
                            </div>
                        </div>

                    </div>

                    <input type="hidden" name="DefaultConfigJson" id="editQuestionConfig" />

                    <div class="form-check">
                        <input class="form-check-input"
                               type="checkbox"
                               id="editQuestionActive"
                               name="IsActive"
                               value="true" />

                        <label class="form-check-label" for="editQuestionActive">
                            Active
                        </label>

                        <input type="hidden" name="IsActive" value="false" />
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>

            </form>

        </div>
    </div>
</div>