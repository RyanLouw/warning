<div class="modal fade" id="modalCreateQuestion" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add New Question</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form method="post" action="@Url.Action("CreateQuestion", "Admin")">
                @Html.AntiForgeryToken()
                <div class="modal-body">

                    <div class="mb-3">
                        <label class="form-label">Question Text</label>
                        <input name="QuestionText" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Control Type</label>
                        <select name="ControlType" id="controlType" class="form-select" required>
                            <option value="">-- Select --</option>
                            <option value="Text">Text</option>
                            <option value="Dropdown">Dropdown</option>
                            <option value="Radio">Radio</option>
                            <option value="Checkbox">Checkbox</option>
                            <option value="TrueFalse">True / False</option>
                            <option value="Number">Number</option>
                            <option value="Date">Date</option>
                        </select>
                    </div>



                    <div class="mb-3" id="configBuilder" style="display:none;">

                        <label class="form-label">Options / Settings</label>


                        <div id="optionsBuilder" style="display:none;">
                            <div class="d-flex gap-2 mb-2">
                                <input id="optionInput" type="text" class="form-control" placeholder="Type an option (e.g. Yes)">
                                <button type="button" class="btn btn-outline-primary" id="btnAddOption">Add</button>
                            </div>

                            <div class="form-text mb-2">
                                Add the options users will pick from (no JSON needed).
                            </div>

                            <ul class="list-group" id="optionsList"></ul>

                            <div class="mt-3">
                                <label class="form-label mb-1">Default selected (optional)</label>
                                <select class="form-select" id="defaultOptionSelect">
                                    <option value="">-- None --</option>
                                </select>
                            </div>
                        </div>

                        <div id="booleanPreset" style="display:none;">
                            <div class="form-text mb-2">
                                This will automatically create options. You can also pick a default.
                            </div>
                            <label class="form-label mb-1">Default selected (optional)</label>
                            <select class="form-select" id="defaultBooleanSelect">
                                <option value="">-- None --</option>
                                <option value="true">True/Yes</option>
                                <option value="false">False/No</option>
                            </select>
                        </div>

    
                        <div id="numberConfig" style="display:none;">
                            <div class="row g-2">
                                <div class="col-md-4">
                                    <label class="form-label mb-1">Min</label>
                                    <input type="number" class="form-control" id="numMin">
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label mb-1">Max</label>
                                    <input type="number" class="form-control" id="numMax">
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label mb-1">Step</label>
                                    <input type="number" class="form-control" id="numStep" value="1">
                                </div>
                            </div>
                        </div>

                       
                    </div>


                    <input type="hidden" name="DefaultConfigJson" id="DefaultConfigJson" />

                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="createQuestionIsActive" name="IsActive" value="true" checked />
                        <label class="form-check-label" for="createQuestionIsActive">Active</label>
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Question</button>
                </div>
            </form>

        </div>
    </div>
</div>


