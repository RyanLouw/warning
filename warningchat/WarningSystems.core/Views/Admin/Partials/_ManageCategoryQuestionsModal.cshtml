<div class="modal fade" id="modalManageCategoryQuestions" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="manageCategoryTitle">Manage Questions</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">

                <input type="hidden" id="manageCategoryId" />

                <div class="row g-3">


                    <div class="col-12 col-lg-5">
                        <div class="border rounded p-3">
                            <h6 class="mb-3">Add Question to Category</h6>

                            <div class="mb-3">
                                <label class="form-label">Select Question</label>
                                <select class="form-select" id="manageAddQuestionSelect">
                                    <option value="">-- Select --</option>

                                </select>
                            </div>

                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="manageIsRequired" />
                                        <label class="form-check-label" for="manageIsRequired">Required</label>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <label class="form-label">Sort Order</label>
                                    <input type="number" class="form-control" id="manageSortOrder" value="0" />
                                </div>
                            </div>

                            <div class="mb-3">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div>
                                        <label class="form-label mb-1">Answer Rules</label>
                                        <div class="form-text">
                                            Set simple rules for what the user may enter. Leave empty if this question does not need extra validation.
                                        </div>
                                    </div>

                                   
                                </div>

                                <div id="manageRulesBuilder" class="border rounded p-3 bg-light-subtle">
                                    <div class="text-muted small">
                                        Select a question first. Rules will appear here based on the question type.
                                    </div>
                                </div>

                            </div>

                            <button class="btn btn-primary" type="button" id="btnAddQuestionToCategory">
                                Add to Category
                            </button>

                            <div class="form-text mt-2">
                                This will add a link row in <code>ws.CategoryQuestion</code>.
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-lg-7">
                        <div class="border rounded p-3">
                            <h6 class="mb-3">Linked Questions</h6>

                            <div class="table-responsive">
                                <table class="table table-sm align-middle" id="linkedQuestionsTable">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Question</th>
                                            <th>Control</th>
                                            <th class="text-center">Required</th>
                                            <th style="width:120px;">Sort</th>
                                            <th style="width:90px;"></th>
                                        </tr>
                                    </thead>
                                    <tbody>

                                        <tr>
                                            <td colspan="5" class="text-muted">
                                                Open a category to load linked questions.
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>

                            <div class="form-text">
                                Later we’ll allow inline edits + save, or auto-save per change.
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
            </div>

        </div>
    </div>
</div>
