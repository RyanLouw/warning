{
  "roles": {
    "Admin": "#{Roles.Admin}#",
    "Legal": "#{Roles.Legal}#",
    "Chairperson": "#{Roles.Chairperson}#",
    "User": "#{Roles.User}#"
  },

  "RoleExclusions": [],

  "Application": {
    "BaseUrl": "#{Application.BaseUrl}#"
  },

  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "Domain": "#{AzureAd.Domain}#",
    "TenantId": "#{AzureAd.TenantId}#",
    "ClientId": "#{AzureAd.ClientId}#",
    "CallbackPath": "/signin-oidc",
    "ClientSecret": "#{AzureAd.ClientSecret}#"
  },

  "CentralConfig": {
    "ClientId": "#{CentralConfig.ClientId}#",
    "BaseUrl": "#{CentralConfig.BaseUrl}#",
    "AuthSalt": "#{CentralConfig.AuthSalt}#",
    "IgnoreEnvironment": false,
    "IncludeAutoSettings": true
  },



  "EmailSettings": {
    "LegalRecipients": [
      "#{EmailSettings.LegalRecipient1}#",
      "#{EmailSettings.LegalRecipient2}#",
      "#{EmailSettings.LegalRecipient3}#"
    ]
  },

  "Graph": {
    "BaseUrl": "https://graph.microsoft.com/v1.0",
    "Scopes": "User.Read User.Read.All"
  },

  "ConnectionStrings": {
    "PitstopDb": "#{ConnectionStrings.PitstopDb}#",
    "SopDb": "#{ConnectionStrings.SopDb}#"
  },
  "https": null,

  "Storage": {
    "ConnectionString": "#{Storage.ConnectionString}#"
  },

  "Serilog": {
    "Using": [
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "Logs/warningsystem-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] {Message:lj} {Properties}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },


  "AllowedHosts": "*"
}