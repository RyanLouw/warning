

@using WarningSystems.Core.Auth.Interface
@using WarningSystems.Core.Services.Interface


@inject ICurrentUserAccessor CurrentUser
@inject IUserRoleService UserRoleService

@{
    IReadOnlyList<string> roles = Array.Empty<string>();

    if (CurrentUser.IsAuthenticated)
    {
        roles = await UserRoleService.GetCurrentUserRolesAsync();
    }

    bool isAdmin = roles.Contains("Admin", StringComparer.OrdinalIgnoreCase);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Issue Tracking System</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WarningSystems.styles.css" asp-append-version="true" />


    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.10.0/css/bootstrap-datepicker.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/tom-select/dist/css/tom-select.bootstrap5.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/tom-select/dist/js/tom-select.complete.min.js"></script>
    <link href="https://cdn.quilljs.com/1.3.7/quill.snow.css" rel="stylesheet" />
    <script src="https://cdn.quilljs.com/1.3.7/quill.min.js"></script>
</head>

<body>
    <div id="appLoader"
         class="app-loader"
         role="status"
         aria-live="polite"
         aria-label="Loading"
         aria-hidden="true">
        <div class="app-loader__panel">
            <div class="app-loader__spinner" aria-hidden="true"></div>
            <div class="app-loader__text">Please wait...</div>
        </div>
    </div>

    <header>
        <nav class="navbar navbar-expand-sm hw-navbar">
            <div class="container-fluid">

                <!-- LEFT: LOGO -->
                <a class="navbar-brand hw-logo d-flex align-items-center"
                   asp-controller="Home" asp-action="Index">
                    <img src="~/logo2.png" alt="HealthWindow" />
                </a>

  
                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- CENTER + RIGHT -->
                <div class="navbar-collapse collapse justify-content-end" id="mainNavbar">
                    <ul class="navbar-nav align-items-center hw-nav">

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                        </li>

                        <li class="nav-item"><span class="hw-sep">|</span></li>

                        @if (isAdmin)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Index">Admin</a>
                            </li>

                            <li class="nav-item"><span class="hw-sep">|</span></li>
                        }

                        @if (CurrentUser.IsAuthenticated)
                        {

                            <li class="nav-item d-none">
                                <span id="currentUserRoles">@string.Join(",", roles)</span>
                            </li>

                            <li class="nav-item">
                                <span class="hw-user" style="margin-left: 10px;">
                                    Welcome <span style="margin-left: 5px">@CurrentUser.DisplayName</span>
                                </span>
                            </li>

                            <li class="nav-item ms-2">
                                <a class="nav-link hw-signout" href="/MicrosoftIdentity/Account/SignOut">
                                    Sign out
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="/MicrosoftIdentity/Account/SignIn">
                                    Sign in
                                </a>
                            </li>
                        }

                    </ul>
                </div>

            </div>
        </nav>
    </header>

    <div class="app-container">
        <main role="main" class="app-main">
            @RenderBody()
        </main>
    </div>



    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>


    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.10.0/js/bootstrap-datepicker.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>


    
</html>


<style>
    .navbar-nav .nav-link {
        color: black !important;
    }

        .navbar-nav .nav-link.active,
        .navbar-nav .nav-link.current-page {
            font-weight: bold !important;
        }
</style>

<script>
            $(document).ready(function () {
        const currentUrl = window.location.pathname;
        $('.navbar-nav a.nav-link').each(function () {
            const linkUrl = $(this).attr('href');
            if (currentUrl === linkUrl) {
                $(this).addClass('active');
            }
        });
    });
</script>
