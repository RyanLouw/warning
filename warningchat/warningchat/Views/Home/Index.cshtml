@using WarningSystems.Core.ViewModels
@model WarningSystems.Core.ViewModels.TaskListVM


@{
    ViewData["Title"] = "Home";

    var roles = Model.CurrentUserRoles ?? Array.Empty<string>();
    bool isUser = roles.Contains("User");
    bool isLegal = roles.Contains("Legal");

    var currentUserId = (Model.CurrentUserId ?? string.Empty).Trim();

    var creatorOptions = Model.TaskList
        .Where(row => !string.IsNullOrWhiteSpace(row.CreatedBy))
        .GroupBy(
            row => row.CreatedBy.Trim(),
            StringComparer.OrdinalIgnoreCase)
        .Select(group => group.First())
        .Where(row => !string.Equals(
            row.CreatedBy.Trim(),
            currentUserId,
            StringComparison.OrdinalIgnoreCase))
        .OrderBy(row =>
            string.IsNullOrWhiteSpace(row.CreatedByDisplayName)
                ? row.CreatedBy
                : row.CreatedByDisplayName)
        .ToList();


    var statusOrder = new[]
      {
        new { Key = "Draft",       Label = "Draft",       CssClass = "draft" },
        new { Key = "New",         Label = "New",         CssClass = "new" },
        new { Key = "In Progress", Label = "In Progress", CssClass = "in-progress" },
        new { Key = "Pending",     Label = "Pending",     CssClass = "pending" },
        new { Key = "Issued",      Label = "Issued",      CssClass = "issued" },
        new { Key = "Validated",   Label = "Validated",   CssClass = "validated" }
    };

}

<div class="ws-page">
    <div class="ws-page-inner">

        <div class="status-bar">

            <div class="status-pill">
                <span class="label">Due</span>
                <span class="count count-due">@Model.Due.ToString()</span>
            </div>

            <div class="status-pill">
                <span class="label">Overdue</span>
                <span class="count count-overdue">@Model.OverDue.ToString()</span>
            </div>

            @foreach (var status in statusOrder)
            {
                var count = Model.TaskList.Count(row => string.Equals(
                    row.Status?.Trim(),
                    status.Key,
                    StringComparison.OrdinalIgnoreCase));
                <div class="status-pill status-@status.CssClass">
                    <span class="label">@status.Label</span>
                    <span class="count count-status">@count</span>
                </div>
            }
        </div>

        <div class="page-actions">
            <button type="button"
                    id="btnAbsenceDiscussion"
                    class="btn btn-lg px-4 me-2"
                    style="border-radius:999px; background:#0f6b7a; color:white;">
                Discussion
            </button>
            <button type="button"
                    id="btnRequestWarning"
                    class="btn btn-lg px-4"
                    style="border-radius:999px; background:#0f6b7a; color:white;">
                Create Issue
            </button>

            <button type="button"
                    id="btnAbsenceDiscussion"
                    class="btn btn-lg px-4"
                    style="border-radius:999px; background:#0f6b7a; color:white;">
                    Absence Discussion
            </button>
        </div>

        <div class="modal fade" id="absenceDiscussionModal" tabindex="-1"
             aria-labelledby="absenceDiscussionModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-centered">
                <div class="modal-content">
                    <form id="absenceDiscussionForm">
                        @Html.AntiForgeryToken()
                        <div class="modal-header">
                            <h5 class="modal-title" id="absenceDiscussionModalLabel">Create absence discussion</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <div id="absenceDiscussionMessage" class="alert alert-danger d-none" role="alert"></div>
                            <div class="mb-3">
                                <label for="absenceEmployeeId" class="form-label">Employee</label>
                                <select id="absenceEmployeeId" class="form-select" required>
                                    <option value="">-- Select employee --</option>
                                    @foreach (var employee in Model.UnderME.OrderBy(user => user.DisplayName))
                                    {
                                        if (!string.IsNullOrWhiteSpace(employee.Id))
                                        {
                                            <option value="@employee.Id">@(employee.DisplayName ?? employee.UserPrincipalName ?? employee.Id)</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="mb-3">
                                <label for="absenceSubType" class="form-label">Discussion subtype</label>
                                <select id="absenceSubType" class="form-select" required>
                                    <option value="">-- Select discussion subtype --</option>
                                    @foreach (var subType in Model.DiscussionSubTypes)
                                    {
                                        <option value="@subType.IssueSubTypeId">@subType.IssueSubTypeName</option>
                                    }
                                </select>
                            </div>
                            <div class="mb-3">
                                <label for="absenceDates" class="form-label">Date(s)</label>
                                <input id="absenceDates" class="form-control" type="date" multiple required />
                                <div class="form-text">The date defaults to today. Add additional dates one at a time.</div>
                                <button type="button" id="addAbsenceDate" class="btn btn-sm btn-outline-secondary mt-2">Add date</button>
                                <div id="selectedAbsenceDates" class="d-flex flex-wrap gap-2 mt-2"></div>
                            </div>
                            <div class="mb-3">
                                <label for="absenceDescription" class="form-label">Description</label>
                                <textarea id="absenceDescription" class="form-control" rows="5" required></textarea>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" id="saveAbsenceDiscussion" class="btn px-4" style="background:#0f6b7a;color:white;">Save discussion</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>


        <div class="main-panel">

            <!-- Tabs -->
            <ul class="nav nav-tabs hw-tabs" id="homeTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="tasklist-tab" data-bs-toggle="tab" data-bs-target="#tasklist"
                            type="button" role="tab" aria-controls="tasklist" aria-selected="true">
                        Task List
                    </button>
                </li>

                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="employee-tab" data-bs-toggle="tab" data-bs-target="#employee"
                            type="button" role="tab" aria-controls="employee" aria-selected="false">
                        Employee
                    </button>
                </li>

                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="reports-tab" data-bs-toggle="tab" data-bs-target="#reports"
                            type="button" role="tab" aria-controls="reports" aria-selected="false">
                        Reports
                    </button>
                </li>
            </ul>


            <div class="tab-content">

                <!-- TASK LIST  -->
                <div class="tab-pane fade show active" id="tasklist" role="tabpanel" aria-labelledby="tasklist-tab">
                    <div class="panel-body">

                        <div class="filters-row mb-3">
                            <div class="filters-left d-flex gap-2 flex-wrap">
                                <div class="search-box">
                                    <input id="taskListSearch"
                                           type="search"
                                           class="form-control form-control-lg"
                                           style="border-radius:999px;"
                                           placeholder="Search employee, created by or status..."
                                           autocomplete="off" />
                                </div>

                            </div>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-hover align-middle"
                                   id="taskListTable">
                                <thead>
                                    <tr>
                                        <th>Status</th>
                                        <th>Employee Name</th>
                                        <th>Created By</th>
                                        <th>Created Date</th>
                                        <th>Due Date</th>
                                        <th>Last Actioned Date</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @if (Model.TaskList == null || !Model.TaskList.Any())
                                    {
                                        <tr>
                                            <td colspan="6"
                                                class="text-center text-muted py-4">
                                                No warnings found.
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var row in Model.TaskList)
                                        {
                                            var status = (row.Status ?? string.Empty).Trim();
                                            var statusKey = status.ToLowerInvariant();

                                            var employeeName =
                                            (row.EmployeeDisplayName ?? string.Empty).Trim();

                                            var createdById =
                                            (row.CreatedBy ?? string.Empty).Trim();

                                            var createdByName =
                                            (row.CreatedByDisplayName ?? string.Empty).Trim();

                                            bool isUserNewOrInProgress =
                                            isUser &&
                                            (statusKey == "new" ||
                                            statusKey == "in progress");

                                            bool canClick =
                                            (isUser && statusKey == "draft") ||
                                            isUserNewOrInProgress ||
                                            (isLegal &&
                                            (statusKey == "new" ||
                                            statusKey == "in progress"));

                                            string? rowUrl = null;

                                            if (canClick)
                                            {
                                                rowUrl = Url.Action(
                                                                                "Redirect",
                                                                                "Home",
                                                new
                                                {
                                                    warningId = row.WarningId,
                                                    status = statusKey
                                                });
                                            }

                                            <tr class="task-list-row @(canClick ? "clickable-row" : "disabled-row")"
                                                data-url="@(rowUrl ?? string.Empty)"
                                                data-employee="@employeeName"
                                                data-created-by-id="@createdById"
                                                data-created-by-name="@createdByName"
                                                data-status="@status">

                                                <td>
                                                    @(canClick ? "🔓" : "🔒")
                                                    @status
                                                </td>

                                                <td>@employeeName</td>
                                                <td>@createdByName</td>
                                                <td>@row.CreatedOn.ToString("yyyy/MM/dd")</td>
                                                <td>@(row.LegalExpiryDate?.ToString("yyyy/MM/dd") ?? "-")</td>
                                                <td>@(row.LastStatusChangedOn?.ToString("yyyy/MM/dd") ?? "-")</td>
                                            </tr>
                                        }

                                        <tr id="taskListNoResults"
                                            class="d-none">
                                            <td colspan="6"
                                                class="text-center text-muted py-4">
                                                No issues match your filters.
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>


                        <div class="table-footer">
                            <div class="pager-buttons btn-group" role="group" aria-label="Pagination">
                                <button class="btn btn-outline-secondary" disabled>1</button>
                            </div>

                            <div class="page-size btn-group" role="group" aria-label="Page size">
                                <button class="btn btn-outline-secondary" disabled>All</button>
                            </div>
                        </div>

                    </div>
                </div>

                <!-- EMPLOYEE  -->
                <div class="tab-pane fade" id="employee" role="tabpanel" aria-labelledby="employee-tab">
                    <div class="panel-body">
                        <h5 class="mb-3">Employees under me</h5>

                        @if (Model.EmployeeRows == null || !Model.EmployeeRows.Any())
                        {
                            <div class="text-muted">
                                No employees found under your reporting line.
                            </div>
                        }
                        else
                        {
                            <div class="filters-row mb-3">
                                <div class="filters-left d-flex gap-2 flex-wrap">
                                    <div class="search-box">
                                        <input id="employeeSearch"
                                               class="form-control form-control-lg"
                                               style="border-radius:999px;"
                                               placeholder="Search employee, department, team lead, manager, status" />
                                    </div>

                                    <div class="assigned-box">
                                        <select id="employeeSort" class="form-select form-select-lg" style="border-radius:999px;">
                                            <option value="desc" selected>Last Actioned Date (Newest first)</option>
                                            <option value="asc">Last Actioned Date (Oldest first)</option>
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <div class="table-responsive">
                                <table class="table table-sm align-middle" id="employeeTable">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Employee Name</th>
                                            <th>Department</th>
                                            <th>Team Leader</th>
                                            <th>Manager</th>
                                            <th>No Issue</th>
                                            <th>Last Actioned Date</th>
                                            <th>Current State</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var row in Model.EmployeeRows)
                                        {
                                            var employeeId = row.EmployeeId ?? "";
                                            var employeeName = row.EmployeeName ?? "";
                                            var department = row.Department ?? "";
                                            var teamLeader = row.TeamLeader ?? "";
                                            var manager = row.Manager ?? "";
                                            var currentState = row.CurrentState ?? "";
                                            var lastActionedDate = row.LastActionedDate?.ToString("yyyy-MM-dd") ?? "";

                                            <tr class="employee-row"
                                                data-employee-id="@employeeId"
                                                data-employee="@employeeName"
                                                data-department="@department"
                                                data-teamleader="@teamLeader"
                                                data-manager="@manager"
                                                data-currentstate="@currentState"
                                                data-lastactioned="@lastActionedDate">
                                                <td>@employeeName</td>
                                                <td>@department</td>
                                                <td>@teamLeader</td>
                                                <td>@manager</td>
                                                <td>@row.NoWarnings</td>
                                                <td>@(row.LastActionedDate?.ToString("yyyy/MM/dd") ?? "-")</td>
                                                <td>@currentState</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>

                <!-- REPORTS TAB -->
                <div class="tab-pane fade"
                     id="reports"
                     role="tabpanel"
                     aria-labelledby="reports-tab">

                    <div class="panel-body">
                        @{
                            var reportRows =
                                Model.ReportRows
                                ?? new List<TransgretionsVM>();

                            var departments = reportRows
                                .Select(row => row.Department?.Trim())
                                .Where(value =>
                                    !string.IsNullOrWhiteSpace(value))
                                .Distinct(StringComparer.OrdinalIgnoreCase)
                                .OrderBy(value => value)
                                .ToList();

                            var issueTypes = reportRows
                                .SelectMany(row =>
                                    row.CategoryNames
                                    ?? new List<string>())
                                .Select(value => value?.Trim())
                                .Where(value =>
                                    !string.IsNullOrWhiteSpace(value))
                                .Distinct(StringComparer.OrdinalIgnoreCase)
                                .OrderBy(value => value)
                                .ToList();

                            var noteTypes = reportRows
                                .Select(row =>
                                    row.LatestNoteType?.Trim())
                                .Where(value =>
                                    !string.IsNullOrWhiteSpace(value))
                                .Distinct(StringComparer.OrdinalIgnoreCase)
                                .OrderBy(value => value)
                                .ToList();
                        }

                        <div class="mb-4">
                            <h4 class="mb-1">Issue Reporting</h4>

                            <div class="text-muted">
                                Filter issues by department, manager, employee,
                                status, issue type and latest action.
                            </div>
                        </div>

                        <div class="row g-3">

                            <!-- FILTERS -->
                            <div class="col-12 col-xl-3">
                                <div class="card border-0 shadow-sm h-100">
                                    <div class="card-body">

                                        <h5 class="card-title mb-3">
                                            Filters
                                        </h5>

                                        <div class="mb-3">
                                            <label class="form-label">
                                                Search
                                            </label>

                                            <input type="search"
                                                   id="reportSearch"
                                                   class="form-control report-filter"
                                                   placeholder="Search report..."
                                                   autocomplete="off" />
                                        </div>

                                        <div class="row g-2 mb-3">
                                            <div class="col-12 col-md-6 col-xl-12">
                                                <label class="form-label">
                                                    Start date
                                                </label>

                                                <input type="date"
                                                       id="reportStartDate"
                                                       class="form-control report-filter" />
                                            </div>

                                            <div class="col-12 col-md-6 col-xl-12">
                                                <label class="form-label">
                                                    End date
                                                </label>

                                                <input type="date"
                                                       id="reportEndDate"
                                                       class="form-control report-filter" />
                                            </div>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label">
                                                Department
                                            </label>

                                            <select id="reportDepartment"
                                                    class="form-select report-filter">

                                                <option value="">
                                                    All departments
                                                </option>

                                                @foreach (var department in departments)
                                                {
                                                    <option value="@department">
                                                        @department
                                                    </option>
                                                }
                                            </select>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label">
                                                Manager
                                            </label>

                                            <select id="reportManager"
                                                    class="form-select report-filter">

                                                <option value="">
                                                    All managers
                                                </option>
                                            </select>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label">
                                                Employee
                                            </label>

                                            <select id="reportEmployee"
                                                    class="form-select report-filter">

                                                <option value="">
                                                    All employees
                                                </option>
                                            </select>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label">
                                                Status
                                            </label>

                                            <select id="reportStatus"
                                                    class="form-select report-filter">

                                                <option value="">
                                                    All statuses
                                                </option>

                                                <option value="draft">
                                                    Draft
                                                </option>

                                                <option value="in progress">
                                                    In Progress
                                                </option>

                                                <option value="completed">
                                                    Completed
                                                </option>
                                            </select>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label">
                                                Issue type
                                            </label>

                                            <select id="reportIssueType"
                                                    class="form-select report-filter">

                                                <option value="">
                                                    All issue types
                                                </option>

                                                @foreach (var issueType in issueTypes)
                                                {
                                                    <option value="@issueType">
                                                        @issueType
                                                    </option>
                                                }
                                            </select>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label">
                                                Latest action
                                            </label>

                                            <select id="reportLatestAction"
                                                    class="form-select report-filter">

                                                <option value="">
                                                    All latest actions
                                                </option>

                                                @foreach (var noteType in noteTypes)
                                                {
                                                    <option value="@noteType">
                                                        @noteType
                                                    </option>
                                                }
                                            </select>
                                        </div>

                                        <button type="button"
                                                id="btnClearReportFilters"
                                                class="btn btn-outline-secondary w-100">
                                            Clear filters
                                        </button>

                                    </div>
                                </div>
                            </div>

                            <!-- CONTENT -->
                            <div class="col-12 col-xl-9">

                                <!-- SIMPLE NUMBERS -->
                                <div class="row g-3 mb-4">

                                    <div class="col-6 col-md-4 col-xl">
                                        <div class="card border-0 shadow-sm h-100">
                                            <div class="card-body text-center">
                                                <div class="small text-muted">
                                                    Departments
                                                </div>

                                                <div class="fs-3 fw-bold"
                                                     id="reportDepartmentCount">
                                                    0
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-6 col-md-4 col-xl">
                                        <div class="card border-0 shadow-sm h-100">
                                            <div class="card-body text-center">
                                                <div class="small text-muted">
                                                    Total Issues
                                                </div>

                                                <div class="fs-3 fw-bold"
                                                     id="reportIssueCount">
                                                    0
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-6 col-md-4 col-xl">
                                        <div class="card border-0 shadow-sm h-100">
                                            <div class="card-body text-center">
                                                <div class="small text-muted">
                                                    Draft
                                                </div>

                                                <div class="fs-3 fw-bold"
                                                     id="reportDraftCount">
                                                    0
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-6 col-md-4 col-xl">
                                        <div class="card border-0 shadow-sm h-100">
                                            <div class="card-body text-center">
                                                <div class="small text-muted">
                                                    In Progress
                                                </div>

                                                <div class="fs-3 fw-bold"
                                                     id="reportInProgressCount">
                                                    0
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-6 col-md-4 col-xl">
                                        <div class="card border-0 shadow-sm h-100">
                                            <div class="card-body text-center">
                                                <div class="small text-muted">
                                                    Completed
                                                </div>

                                                <div class="fs-3 fw-bold"
                                                     id="reportCompletedCount">
                                                    0
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                </div>

                                <div class="row g-3 mb-4">

                                    <div class="col-6 col-md-4 col-xl">
                                        <div class="card border-0 shadow-sm h-100">
                                            <div class="card-body text-center">
                                                <div class="small text-muted">
                                                    Discussion
                                                </div>

                                                <div class="fs-3 fw-bold"
                                                     id="reportDiscussionCount">
                                                    0
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-6 col-md-4 col-xl">
                                        <div class="card border-0 shadow-sm h-100">
                                            <div class="card-body text-center">
                                                <div class="small text-muted">
                                                    Warning
                                                </div>

                                                <div class="fs-3 fw-bold"
                                                     id="reportWarningTypeCount">
                                                    0
                                                </div>
                                            </div>
                                        </div>
                                    </div>


                                </div>

                                <!-- DEPARTMENT BREAKDOWN -->
                                <div class="card border-0 shadow-sm mb-4">
                                    <div class="card-body">

                                        <h5 class="card-title">
                                            Department Breakdown
                                        </h5>

                                        <div class="table-responsive">
                                            <table class="table table-sm align-middle">
                                                <thead>
                                                    <tr>
                                                        <th>Department</th>
                                                        <th>Total</th>
                                                        <th>Draft</th>
                                                        <th>In Progress</th>
                                                        <th>Completed</th>

                                                     
                                                        <th>Warning</th>

                                                    </tr>
                                                </thead>

                                                <tbody id="reportDepartmentBreakdown">
                                                </tbody>
                                            </table>
                                        </div>

                                    </div>
                                </div>

                                <!-- COLLAPSIBLE ISSUE DETAILS -->
                                <div class="card border-0 shadow-sm">

                                    <div class="card-header bg-white border-0 p-0">
                                        <button type="button"
                                                class="btn w-100 d-flex align-items-center justify-content-between text-start p-3 collapsed"
                                                data-bs-toggle="collapse"
                                                data-bs-target="#reportIssueDetailsCollapse"
                                                aria-expanded="false"
                                                aria-controls="reportIssueDetailsCollapse">

                                            <span>
                                                <span class="fw-semibold">
                                                    Issue Details
                                                </span>

                                                <span class="badge bg-secondary ms-2"
                                                      id="reportVisibleDetailCount">
                                                    0
                                                </span>

                                                <span class="text-muted small ms-2">
                                                    filtered records
                                                </span>
                                            </span>

                                            <span class="report-collapse-arrow">
                                                ▼
                                            </span>
                                        </button>
                                    </div>

                                    <div id="reportIssueDetailsCollapse"
                                         class="collapse">

                                        <div class="card-body border-top">

                                            <div class="text-muted small mb-3">
                                                These records already reflect the selected report filters.
                                            </div>

                                            <div class="table-responsive">
                                                <table class="table table-hover align-middle"
                                                       id="reportsTable">

                                                    <thead>
                                                        <tr>
                                                            <th>Status</th>
                                                            <th>Issue Type</th>
                                                            <th>Employee</th>
                                                            <th>Department</th>
                                                            <th>Manager</th>
                                                            <th>Created By</th>
                                                            <th>Created Date</th>
                                                            <th>Due Date</th>
                                                            <th>Latest Action</th>
                                                            <th>Latest Action Date</th>
                                                        </tr>
                                                    </thead>

                                                    <tbody>
                                                        @if (!reportRows.Any())
                                                        {
                                                            <tr>
                                                                <td colspan="10"
                                                                    class="text-center text-muted py-4">
                                                                    No report data found.
                                                                </td>
                                                            </tr>
                                                        }
                                                        else
                                                        {
                                                            @foreach (var row in reportRows)
                                                            {
                                                                var employeeName =
                                                                row.EmployeeDisplayName?.Trim()
                                                                ?? string.Empty;

                                                                var department =
                                                                row.Department?.Trim()
                                                                ?? string.Empty;

                                                                var manager =
                                                                row.Manager?.Trim()
                                                                ?? string.Empty;

                                                                var createdBy =
                                                                row.CreatedByDisplayName?.Trim()
                                                                ?? string.Empty;

                                                                var status =
                                                                row.Status?.Trim()
                                                                ?? string.Empty;

                                                                var latestAction =
                                                                row.LatestNoteType?.Trim()
                                                                ?? string.Empty;

                                                                var rowIssueTypes =
                                                                row.CategoryNames
                                                                ?? new List<string>();

                                                                var issueTypeText =
                                                                rowIssueTypes.Count > 0
                                                                ? string.Join(
                                                                ", ",
                                                                rowIssueTypes)
                                                                : row.IssueType
                                                                ?? string.Empty;

                                                                var issueTypeData =
                                                                string.Join(
                                                                "|",
                                                                rowIssueTypes
                                                                .Where(value =>
                                                                !string.IsNullOrWhiteSpace(value))
                                                                .Select(value =>
                                                                value.Trim()
                                                                .ToLowerInvariant()));

                                                                <tr class="report-row"
                                                                    data-employee="@employeeName"
                                                                    data-department="@department"
                                                                    data-manager="@manager"
                                                                    data-created-by="@createdBy"
                                                                    data-status="@status"
                                                                    data-issue-types="@issueTypeData"
                                                                    data-latest-action="@latestAction"
                                                                    data-created="@row.CreatedOn.ToString("yyyy-MM-dd")"
                                                                    data-issued-to-employee="@row.IssuedToEmployee.ToString().ToLowerInvariant()">

                                                                    <td>@status</td>

                                                                    <td>
                                                                        @(string.IsNullOrWhiteSpace(issueTypeText)
                                                                                                                                        ? "-"
                                                                                                                                        : issueTypeText)
                                                                    </td>

                                                                    <td>@employeeName</td>

                                                                    <td>
                                                                        @(string.IsNullOrWhiteSpace(department)
                                                                                                                                        ? "-"
                                                                                                                                        : department)
                                                                    </td>

                                                                    <td>
                                                                        @(string.IsNullOrWhiteSpace(manager)
                                                                                                                                        ? "-"
                                                                                                                                        : manager)
                                                                    </td>

                                                                    <td>
                                                                        @(string.IsNullOrWhiteSpace(createdBy)
                                                                                                                                        ? "-"
                                                                                                                                        : createdBy)
                                                                    </td>

                                                                    <td>
                                                                        @row.CreatedOn.ToString("yyyy/MM/dd")
                                                                    </td>

                                                                    <td>
                                                                        @(row.LegalExpiryDate?
                                                                                                                                        .ToString("yyyy/MM/dd")
                                                                                                                                        ?? "-")
                                                                    </td>

                                                                    <td>
                                                                        @(string.IsNullOrWhiteSpace(latestAction)
                                                                                                                                        ? "-"
                                                                                                                                        : latestAction)
                                                                    </td>

                                                                    <td>
                                                                        @(row.LatestNoteDate?
                                                                                                                                        .ToString("yyyy/MM/dd HH:mm")
                                                                                                                                        ?? "-")
                                                                    </td>
                                                                </tr>
                                                            }

                                                            <tr id="reportNoResults"
                                                                class="d-none">

                                                                <td colspan="10"
                                                                    class="text-center text-muted py-4">
                                                                    No report records match the selected filters.
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>

                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>




            </div>
        </div>

    </div>
</div>


<div class="modal fade" id="employeeDashboardModal" tabindex="-1" aria-labelledby="employeeDashboardModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="employeeDashboardModalLabel">Employee Dashboard</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="employeeDashboardModalBody">
                <div class="text-center py-4">Loading...</div>
            </div>
        </div>
    </div>
</div>


<script>
    function filterTaskList() {
        const searchValue = (
            document.getElementById("taskListSearch")?.value || ""
        )
            .trim()
            .toLowerCase();

        const selectedCreatedById = (
            document.getElementById("taskListCreatedByFilter")?.value || ""
        )
            .trim()
            .toLowerCase();

        const rows = Array.from(
            document.querySelectorAll(
                "#taskListTable tbody tr.task-list-row"
            )
        );

        let visibleRowCount = 0;

        rows.forEach(row => {
            const employeeName = (
                row.dataset.employee || ""
            ).toLowerCase();

            const createdByName = (
                row.dataset.createdByName || ""
            ).toLowerCase();

            const createdById = (
                row.dataset.createdById || ""
            ).toLowerCase();

            const status = (
                row.dataset.status || ""
            ).toLowerCase();

            const matchesSearch =
                !searchValue ||
                employeeName.includes(searchValue) ||
                createdByName.includes(searchValue) ||
                status.includes(searchValue);

            const matchesCreatedBy =
                !selectedCreatedById ||
                createdById === selectedCreatedById;

            const showRow =
                matchesSearch &&
                matchesCreatedBy;

            row.classList.toggle(
                "d-none",
                !showRow
            );

            if (showRow) {
                visibleRowCount++;
            }
        });

        const noResultsRow =
            document.getElementById("taskListNoResults");

        if (noResultsRow) {
            const showNoResults =
                rows.length > 0 &&
                visibleRowCount === 0;

            noResultsRow.classList.toggle(
                "d-none",
                !showNoResults
            );
        }
    }

    document.addEventListener("input", function (e) {
        if (e.target?.id === "taskListSearch") {
            filterTaskList();
        }
    });

    document.addEventListener("change", function (e) {
        if (e.target?.id === "taskListCreatedByFilter") {
            filterTaskList();
        }
    });

    document.addEventListener("DOMContentLoaded", function () {
        filterTaskList();
    });


    document.addEventListener("click", async function (e) {
        const row = e.target.closest(".employee-row");
        if (!row) return;

        const employeeId = row.dataset.employeeId;
        const employeeName = row.dataset.employeeName || "Employee";

        const modalElement = document.getElementById("employeeDashboardModal");
        const modalBody = document.getElementById("employeeDashboardModalBody");
        const modalTitle = document.getElementById("employeeDashboardModalLabel");

        modalTitle.textContent = `Employee Dashboard - ${employeeName}`;
        modalBody.innerHTML = `<div class="text-center py-4">Loading...</div>`;

        const modal = new bootstrap.Modal(modalElement);
        modal.show();

        try {
            const response = await fetch(`/Home/EmployeeDashboard?employeeId=${encodeURIComponent(employeeId)}`, {
                method: "GET",
                headers: {
                    "X-Requested-With": "XMLHttpRequest"
                }
            });

            if (!response.ok) {
                throw new Error("Failed to load employee dashboard.");
            }

            const html = await response.text();
            modalBody.innerHTML = html;
        } catch (error) {
            console.error(error);
            modalBody.innerHTML = `
                    <div class="alert alert-danger">
                        Could not load employee dashboard.
                    </div>`;
        }
    });

    function filterAndSortEmployeeTable() {
        const searchValue = (document.getElementById("employeeSearch")?.value || "").toLowerCase().trim();
        const sortValue = document.getElementById("employeeSort")?.value || "desc";

        const tableBody = document.querySelector("#employeeTable tbody");
        if (!tableBody) return;

        const rows = Array.from(tableBody.querySelectorAll("tr"));

        rows.forEach(row => {
            const employee = (row.dataset.employee || "").toLowerCase();
            const department = (row.dataset.department || "").toLowerCase();
            const teamLeader = (row.dataset.teamleader || "").toLowerCase();
            const manager = (row.dataset.manager || "").toLowerCase();
            const currentState = (row.dataset.currentstate || "").toLowerCase();

            const matchesSearch =
                !searchValue ||
                employee.includes(searchValue) ||
                department.includes(searchValue) ||
                teamLeader.includes(searchValue) ||
                manager.includes(searchValue) ||
                currentState.includes(searchValue);

            row.style.display = matchesSearch ? "" : "none";
        });

        const visibleRows = rows.filter(r => r.style.display !== "none");

        visibleRows.sort((a, b) => {
            const aDateStr = a.dataset.lastactioned || "";
            const bDateStr = b.dataset.lastactioned || "";

            const aDate = aDateStr ? new Date(aDateStr) : null;
            const bDate = bDateStr ? new Date(bDateStr) : null;

            // Push empty dates to the bottom
            if (!aDate && !bDate) return 0;
            if (!aDate) return 1;
            if (!bDate) return -1;

            return sortValue === "asc"
                ? aDate - bDate
                : bDate - aDate;
        });

        visibleRows.forEach(row => tableBody.appendChild(row));
    }

    document.addEventListener("input", function (e) {
        if (e.target && e.target.id === "employeeSearch") {
            filterAndSortEmployeeTable();
        }
    });

    document.addEventListener("change", function (e) {
        if (e.target && e.target.id === "employeeSort") {
            filterAndSortEmployeeTable();
        }
    });

    document.addEventListener("DOMContentLoaded", function () {
        filterAndSortEmployeeTable();
    });





    document.addEventListener("click", function (e) {
        const row = e.target.closest("tr.clickable-row");
        if (!row) return;

        const url = row.dataset.url;
        if (url) window.location.href = url;
    });

    document.getElementById("btnRequestWarning").addEventListener("click", function () {
        window.location.href = '@Url.Action("Index", "Transgression")';
    });

    (function initialiseAbsenceDiscussion() {
        const form = document.getElementById("absenceDiscussionForm");
        const dateInput = document.getElementById("absenceDates");
        const dateList = document.getElementById("selectedAbsenceDates");
        const message = document.getElementById("absenceDiscussionMessage");
        const modalElement = document.getElementById("absenceDiscussionModal");
        const dates = new Set();

        function today() {
            const now = new Date();
            return new Date(now.getTime() - now.getTimezoneOffset() * 60000).toISOString().slice(0, 10);
        }

        function renderDates() {
            dateList.innerHTML = "";
            [...dates].sort().forEach(date => {
                const badge = document.createElement("button");
                badge.type = "button";
                badge.className = "btn btn-sm btn-outline-secondary";
                badge.textContent = `${date} ×`;
                badge.setAttribute("aria-label", `Remove ${date}`);
                badge.addEventListener("click", () => { dates.delete(date); renderDates(); });
                dateList.appendChild(badge);
            });
        }

        document.getElementById("btnAbsenceDiscussion").addEventListener("click", function () {
            form.reset();
            dates.clear();
            dateInput.value = today();
            dateInput.max = today();
            dates.add(dateInput.value);
            renderDates();
            message.classList.add("d-none");
            bootstrap.Modal.getOrCreateInstance(modalElement).show();
        });

        document.getElementById("addAbsenceDate").addEventListener("click", function () {
            if (dateInput.value) dates.add(dateInput.value);
            renderDates();
        });

        form.addEventListener("submit", async function (event) {
            event.preventDefault();
            if (dateInput.value) dates.add(dateInput.value);
            if (!form.reportValidity() || dates.size === 0) return;

            const saveButton = document.getElementById("saveAbsenceDiscussion");
            saveButton.disabled = true;
            message.classList.add("d-none");

            const response = await fetch('@Url.Action("CreateAbsenceDiscussion", "Home")', {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    "RequestVerificationToken": form.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: JSON.stringify({
                    employeeId: document.getElementById("absenceEmployeeId").value,
                    issueSubTypeId: Number(document.getElementById("absenceSubType").value),
                    dates: [...dates],
                    description: document.getElementById("absenceDescription").value
                })
            });

            const result = await response.json().catch(() => ({}));
            if (response.ok && result.success) {
                window.location.reload();
                return;
            }

            message.textContent = result.message || "The discussion could not be saved.";
            message.classList.remove("d-none");
            saveButton.disabled = false;
        });
    })();


    function getReportDate(value) {
        if (!value) return null;

        const date = new Date(value + "T00:00:00");
        date.setHours(0, 0, 0, 0);

        return date;
    }

    function normaliseReportValue(value) {
        return (value || "")
            .trim()
            .toLowerCase();
    }

    function parseReportDate(value) {
        if (!value) {
            return null;
        }

        const date = new Date(`${value}T00:00:00`);

        if (Number.isNaN(date.getTime())) {
            return null;
        }

        date.setHours(0, 0, 0, 0);

        return date;
    }

    function getReportRows() {
        return Array.from(
            document.querySelectorAll(
                "#reportsTable tbody tr.report-row"
            )
        );
    }

    function populateReportSelect(
        selectId,
        values,
        placeholder,
        preferredValue = ""
    ) {
        const select =
            document.getElementById(selectId);

        if (!select) {
            return;
        }

        const normalisedPreferredValue =
            normaliseReportValue(preferredValue);

        select.innerHTML = "";

        const defaultOption =
            document.createElement("option");

        defaultOption.value = "";
        defaultOption.textContent = placeholder;

        select.appendChild(defaultOption);

        const uniqueValues = new Map();

        values.forEach(value => {
            const cleanValue = (value || "").trim();

            if (!cleanValue) {
                return;
            }

            const key = normaliseReportValue(cleanValue);

            if (!uniqueValues.has(key)) {
                uniqueValues.set(key, cleanValue);
            }
        });

        Array.from(uniqueValues.values())
            .sort((left, right) =>
                left.localeCompare(right))
            .forEach(value => {
                const option =
                    document.createElement("option");

                option.value = value;
                option.textContent = value;

                select.appendChild(option);
            });

        const matchingOption =
            Array.from(select.options)
                .find(option =>
                    normaliseReportValue(option.value) ===
                    normalisedPreferredValue);

        if (matchingOption) {
            select.value = matchingOption.value;
        }
    }

    function rebuildReportManagers() {
        const department =
            normaliseReportValue(
                document.getElementById(
                    "reportDepartment"
                )?.value
            );

        const managerSelect =
            document.getElementById(
                "reportManager"
            );

        const previousManager =
            managerSelect?.value || "";

        const managers = getReportRows()
            .filter(row => {
                const rowDepartment =
                    normaliseReportValue(
                        row.dataset.department
                    );

                return !department ||
                    rowDepartment === department;
            })
            .map(row =>
                row.dataset.manager || "");

        populateReportSelect(
            "reportManager",
            managers,
            "All managers",
            previousManager
        );
    }

    function rebuildReportEmployees() {
        const department =
            normaliseReportValue(
                document.getElementById(
                    "reportDepartment"
                )?.value
            );

        const manager =
            normaliseReportValue(
                document.getElementById(
                    "reportManager"
                )?.value
            );

        const employeeSelect =
            document.getElementById(
                "reportEmployee"
            );

        const previousEmployee =
            employeeSelect?.value || "";

        const employees = getReportRows()
            .filter(row => {
                const rowDepartment =
                    normaliseReportValue(
                        row.dataset.department
                    );

                const rowManager =
                    normaliseReportValue(
                        row.dataset.manager
                    );

                const matchesDepartment =
                    !department ||
                    rowDepartment === department;

                const matchesManager =
                    !manager ||
                    rowManager === manager;

                return matchesDepartment &&
                    matchesManager;
            })
            .map(row =>
                row.dataset.employee || "");

        populateReportSelect(
            "reportEmployee",
            employees,
            "All employees",
            previousEmployee
        );
    }

    function getReportIssueTypes(row) {
        return (row.dataset.issueTypes || "")
            .split("|")
            .map(normaliseReportValue)
            .filter(Boolean);
    }

    function rowHasIssueType(
        row,
        issueType
    ) {
        if (!issueType) {
            return true;
        }

        return getReportIssueTypes(row)
            .includes(issueType);
    }

    function setReportCount(
        elementId,
        value
    ) {
        const element =
            document.getElementById(elementId);

        if (element) {
            element.textContent =
                value.toString();
        }
    }

    function buildDepartmentBreakdown(
        visibleRows
    ) {
        const tableBody =
            document.getElementById(
                "reportDepartmentBreakdown"
            );

        if (!tableBody) {
            return;
        }

        const departments = new Map();

        visibleRows.forEach(row => {
            const departmentName =
                (row.dataset.department || "")
                    .trim() || "Unknown";

            const departmentKey =
                normaliseReportValue(
                    departmentName
                );

            if (!departments.has(departmentKey)) {
                departments.set(
                    departmentKey,
                    {
                        name: departmentName,
                        total: 0,
                        draft: 0,
                        inProgress: 0,
                        completed: 0,
                        invalid: 0,
                        discussion: 0,
                        warning: 0,
                        hearingNotice: 0,
                        issued: 0
                    }
                );
            }

            const summary =
                departments.get(
                    departmentKey
                );

            const status =
                normaliseReportValue(
                    row.dataset.status
                );

            const issueTypes =
                getReportIssueTypes(row);

            summary.total++;

            if (status === "draft") {
                summary.draft++;
            }

            if (status === "in progress") {
                summary.inProgress++;
            }

            if (status === "completed") {
                summary.completed++;
            }

            if (issueTypes.includes("invalid")) {
                summary.invalid++;
            }

            if (issueTypes.includes("discussion")) {
                summary.discussion++;
            }

            if (
                status === "warning" ||
                issueTypes.includes("warning")) {
                summary.warning++;
            }

            if (
                issueTypes.includes(
                    "hearing notice"
                )
            ) {
                summary.hearingNotice++;
            }

            if (
                row.dataset.issuedToEmployee ===
                "true"
            ) {
                summary.issued++;
            }
        });

        tableBody.innerHTML = "";

        if (departments.size === 0) {
            tableBody.innerHTML = `
                    <tr>
                        <td colspan="10"
                            class="text-center text-muted py-3">
                            No department data found.
                        </td>
                    </tr>`;

            return;
        }

        Array.from(departments.values())
            .sort((left, right) =>
                left.name.localeCompare(
                    right.name))
            .forEach(summary => {
                const row =
                    document.createElement("tr");

                row.innerHTML = `
                        <td>${escapeReportHtml(summary.name)}</td>
                        <td>${summary.total}</td>
                        <td>${summary.draft}</td>
                        <td>${summary.inProgress}</td>
                        <td>${summary.completed}</td>
                        <td>${summary.warning}</td>
                    `;

          
                tableBody.appendChild(row);
            });
    }

    function escapeReportHtml(value) {
        const element =
            document.createElement("div");

        element.textContent =
            value || "";

        return element.innerHTML;
    }

    function updateReportSummary(visibleRows) {
        const departmentCount = new Set(
            visibleRows
                .map(row =>
                    normaliseReportValue(
                        row.dataset.department
                    )
                )
                .filter(Boolean)
        ).size;

        const countStatus = (...statuses) => {
            return visibleRows.filter(row => {
                const rowStatus =
                    normaliseReportValue(
                        row.dataset.status
                    );

                return statuses.includes(rowStatus);
            }).length;
        };

        const countIssueType = issueType => {
            return visibleRows.filter(row =>
                getReportIssueTypes(row)
                    .includes(issueType)
            ).length;
        };

        const issuedCount = visibleRows.filter(row =>
            normaliseReportValue(
                row.dataset.issuedToEmployee
            ) === "true"
        ).length;

        setReportCount(
            "reportVisibleDetailCount",
            visibleRows.length
        );

        setReportCount(
            "reportDepartmentCount",
            departmentCount
        );

        setReportCount(
            "reportIssueCount",
            visibleRows.length
        );

        setReportCount(
            "reportDraftCount",
            countStatus("draft")
        );

        setReportCount(
            "reportInProgressCount",
            countStatus(
                "new",
                "in progress"
            )
        );

        setReportCount(
            "reportCompletedCount",
            countStatus("completed")
        );

        setReportCount(
            "reportInvalidCount",
            countIssueType("invalid")
        );

        setReportCount(
            "reportDiscussionCount",
            countIssueType("discussion")
        );

        const warningCount = visibleRows.filter(row => {
            const rowStatus = normaliseReportValue(
                row.dataset.status
            );

            const rowIssueTypes =
                getReportIssueTypes(row);

            return (
                rowStatus === "warning" ||
                rowIssueTypes.includes("warning")
            );
        }).length;

        setReportCount(
            "reportWarningTypeCount",
            warningCount
        );

  
        buildDepartmentBreakdown(visibleRows);
    }

    function filterReportsTable() {
        const search =
            normaliseReportValue(
                document.getElementById(
                    "reportSearch"
                )?.value
            );

        const startDate =
            parseReportDate(
                document.getElementById(
                    "reportStartDate"
                )?.value
            );

        const endDate =
            parseReportDate(
                document.getElementById(
                    "reportEndDate"
                )?.value
            );

        const department =
            normaliseReportValue(
                document.getElementById(
                    "reportDepartment"
                )?.value
            );

        const manager =
            normaliseReportValue(
                document.getElementById(
                    "reportManager"
                )?.value
            );

        const employee =
            normaliseReportValue(
                document.getElementById(
                    "reportEmployee"
                )?.value
            );

        const status =
            normaliseReportValue(
                document.getElementById(
                    "reportStatus"
                )?.value
            );

        const issueType =
            normaliseReportValue(
                document.getElementById(
                    "reportIssueType"
                )?.value
            );

        const latestAction =
            normaliseReportValue(
                document.getElementById(
                    "reportLatestAction"
                )?.value
            );

        const rows =
            getReportRows();

        const visibleRows = [];

        rows.forEach(row => {
            const rowEmployee =
                normaliseReportValue(
                    row.dataset.employee
                );

            const rowDepartment =
                normaliseReportValue(
                    row.dataset.department
                );

            const rowManager =
                normaliseReportValue(
                    row.dataset.manager
                );

            const rowCreatedBy =
                normaliseReportValue(
                    row.dataset.createdBy
                );

            const rowStatus =
                normaliseReportValue(
                    row.dataset.status
                );

            const rowLatestAction =
                normaliseReportValue(
                    row.dataset.latestAction
                );

            const rowCreatedDate =
                parseReportDate(
                    row.dataset.created
                );

            const rowIssueTypes =
                getReportIssueTypes(row);

            const searchText = [
                rowEmployee,
                rowDepartment,
                rowManager,
                rowCreatedBy,
                rowStatus,
                rowLatestAction,
                ...rowIssueTypes
            ].join(" ");

            let show = true;

            if (
                search &&
                !searchText.includes(search)
            ) {
                show = false;
            }

            if (
                department &&
                rowDepartment !== department
            ) {
                show = false;
            }

            if (
                manager &&
                rowManager !== manager
            ) {
                show = false;
            }

            if (
                employee &&
                rowEmployee !== employee
            ) {
                show = false;
            }

            if (
                status &&
                rowStatus !== status
            ) {
                show = false;
            }

            if (
                issueType &&
                !rowIssueTypes.includes(
                    issueType
                )
            ) {
                show = false;
            }

            if (
                latestAction &&
                rowLatestAction !==
                latestAction
            ) {
                show = false;
            }

            if (
                startDate &&
                (
                    !rowCreatedDate ||
                    rowCreatedDate < startDate
                )
            ) {
                show = false;
            }

            if (
                endDate &&
                (
                    !rowCreatedDate ||
                    rowCreatedDate > endDate
                )
            ) {
                show = false;
            }

            row.classList.toggle(
                "d-none",
                !show
            );

            if (show) {
                visibleRows.push(row);
            }
        });

        const noResultsRow =
            document.getElementById(
                "reportNoResults"
            );

        if (noResultsRow) {
            noResultsRow.classList.toggle(
                "d-none",
                visibleRows.length > 0
            );
        }

        updateReportSummary(
            visibleRows
        );
    }

    function clearReportFilters() {
        [
            "reportSearch",
            "reportStartDate",
            "reportEndDate",
            "reportDepartment",
            "reportManager",
            "reportEmployee",
            "reportStatus",
            "reportIssueType",
            "reportLatestAction"
        ].forEach(elementId => {
            const element =
                document.getElementById(
                    elementId
                );

            if (element) {
                element.value = "";
            }
        });

        rebuildReportManagers();
        rebuildReportEmployees();
        filterReportsTable();
    }

    document.addEventListener(
        "input",
        function (event) {
            if (
                event.target?.id ===
                "reportSearch"
            ) {
                filterReportsTable();
            }
        }
    );

    document.addEventListener(
        "change",
        function (event) {
            const targetId =
                event.target?.id;

            if (targetId === "reportDepartment") {
                const manager =
                    document.getElementById(
                        "reportManager"
                    );

                const employee =
                    document.getElementById(
                        "reportEmployee"
                    );

                if (manager) {
                    manager.value = "";
                }

                if (employee) {
                    employee.value = "";
                }

                rebuildReportManagers();
                rebuildReportEmployees();
                filterReportsTable();

                return;
            }

            if (targetId === "reportManager") {
                const employee =
                    document.getElementById(
                        "reportEmployee"
                    );

                if (employee) {
                    employee.value = "";
                }

                rebuildReportEmployees();
                filterReportsTable();

                return;
            }

            if (
                event.target?.classList
                    .contains("report-filter")
            ) {
                filterReportsTable();
            }
        }
    );

    document
        .getElementById(
            "btnClearReportFilters"
        )
        ?.addEventListener(
            "click",
            clearReportFilters
        );

    document.addEventListener(
        "DOMContentLoaded",
        function () {
            rebuildReportManagers();
            rebuildReportEmployees();
            filterReportsTable();
        }
    );

    document.addEventListener("change", function (e) {
        if (e.target && e.target.classList.contains("report-filter")) {
            filterReportsTable();
        }
    });

    document.addEventListener("DOMContentLoaded", function () {
        filterReportsTable();
    });
</script>
